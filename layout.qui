private void | error validate(string source, int width)
    if width <= 0
        return error("layout width must be positive", code = "TEXT_LAYOUT")
    int[] codes := source.codepoints()
    for int code := codes[]
        if code < 32 or code > 126
            return error("layout accepts printable ASCII and spaces", code = "TEXT_LAYOUT")
    return void

string[] | error wrap(string source, int width)
    try validate(source, width)
    string[] lines := []
    string current := ""
    for string word := source.split(" ")[]
        if word == ""
            continue
        if int(len(word)) > width
            return error("word exceeds layout width", code = "TEXT_LAYOUT")
        if current == ""
            current = word
        elif int(len(current) + 1 + len(word)) <= width
            current += " " + word
        else
            lines = lines.append(current)
            current = word
    if current != "" or len(lines) == 0
        lines = lines.append(current)
    return lines

string[] | error justify(string source, int width, bool extra_right := false)
    string[] lines := try wrap(source, width)
    string[] result := []
    for nat index < len(lines)
        string[] words := lines[index].split(" ")
        string line := ""
        if index + 1 == len(lines) or len(words) == 1 or lines[index] == ""
            line = lines[index]
            line += string.repeat(" ", nat(width - int(len(line))))
        else
            int letters := 0
            for string word := words[]
                letters += int(len(word))
            int gaps := int(len(words)) - 1
            int base := (width - letters) / gaps
            int extra := (width - letters) % gaps
            for nat i < len(words)
                if i > 0
                    bool award_extra := if extra_right then int(i) > gaps - extra else int(i) <= extra
                    int blanks := base + (if award_extra then 1 else 0)
                    line += string.repeat(" ", nat(blanks))
                line += words[i]
        result = result.append(line)
    return result
