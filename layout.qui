private void | error validate(string source, int width)
    if width <= 0
        return error("layout width must be positive", code = "TEXT_LAYOUT")
    codes := source.codepoints()
    for code := codes[]
        if code < 32 or code > 126
            return error("layout accepts printable ASCII and spaces", code = "TEXT_LAYOUT")
    return void

string[] | error wrap(string source, int width)
    try validate(source, width)
    string[] lines := []
    current := ""
    for word := source.split(" ")[]
        if word == ""
            continue
        if word.len() > width
            return error("word exceeds layout width", code = "TEXT_LAYOUT")
        if current == ""
            current = word
        elif current.len() + 1 + word.len() <= width
            current += " " + word
        else
            lines = lines.append(current)
            current = word
    if current != "" or lines.len() == 0
        lines = lines.append(current)
    return lines

string[] | error justify(string source, int width, extra_right := false)
    lines := try wrap(source, width)
    string[] result := []
    for: nat index < lines.len()
        words := lines[index].split(" ")
        line := ""
        if index + 1 == lines.len() or words.len() == 1 or lines[index] == ""
            line = lines[index]
            line += string.repeat(" ", nat(width - line.len()))
        else
            letters := 0
            for word := words[]
                letters += word.len()
            gaps := int(words.len()) - 1
            base := (width - letters) / gaps
            extra := (width - letters) % gaps
            for: nat i < words.len()
                if i > 0
                    award_extra := if extra_right then i > gaps - extra else i <= extra
                    blanks := base + (if award_extra then 1 else 0)
                    line += string.repeat(" ", nat(blanks))
                line += words[i]
        result = result.append(line)
    return result
