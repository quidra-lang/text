import text

int[] integers := [-12, 0, 34]
println("integers={text.join(integers, " ")}")
println("no-separator={text.join(integers, "")}")
int[] empty := []
println("empty=|{text.join(empty, ",")}|")
int[] singleton := [5]
println("singleton={text.join(singleton, "--")}")
nat64[] naturals := [0, 18446744073709551615]
println("naturals={text.join(naturals, ":")}")
bool[] flags := [true, false, true]
println("bools={text.join(flags, "|")}")
real64[] fractions := [1.5, -2.25]
println("fractions={text.join(fractions, ";")}")
string[] words := ["a", "", "b"]
println("strings={text.join(words, "::")}")
(int, string)[] pairs := [(1, "x"), (2, "y")]
println("tuples={text.join(pairs, ";")}")
