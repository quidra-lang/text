import text

string[] parts := text.identifier.words("HTTPServer_name")
println("identifier={parts.join("|")}")
println("snake={text.identifier.snake("getLastLoginTime")}")
println("camel={text.identifier.camel("first-second_value")}")
println("pascal={text.identifier.pascal("first_second")}")
println("kebab={text.identifier.kebab("lastLoginDate")}")

groups := text.runs("AAABAA")
println("runs={len(groups)}")
(string first, nat count) := groups[0]
println("first-run={first}:{count}")

initial := text.calendar.Date(2024, 2, 28)
advanced := text.calendar.add_days(initial, 2)
println("date={text.calendar.iso(advanced)}")
println("weekday={text.calendar.weekday(advanced)}")
println("between={text.calendar.days_between(initial, advanced)}")
grid := text.calendar.month_grid(2024, 2)
println("grid-header={grid[0]}")
println("grid-last={grid[len(grid) - 1]}")
match text.calendar.parse("2026-02-30")
    text.calendar.Date invalid
        println("unexpected")
    error problem
        println("date-error")

wrapped := text.layout.wrap("a bb ccc", 7)
println("wrapped={wrapped.join("|")}")
justified := text.layout.justify("a bb ccc", 7)
for string line := justified[]
    println("|{line}|")
spread_left := text.layout.justify("a b c xxx", 8)
spread_right := text.layout.justify("a b c xxx", 8, extra_right = true)
println("left=|{spread_left[0]}|")
println("right=|{spread_right[0]}|")
println("last=|{spread_right[1]}|")
match text.layout.wrap("abcdefgh", 5)
    string[] bad
        println("unexpected")
    error problem
        println("width-error")

tokens := text.lex.tokenize("x12<=5 + 3")
println("tokens={tokens.join("|")}")
text.lex.Cursor cursor := text.lex.Cursor(tokens)
.cursor.expect("x12")
println("accept={.cursor.accept("<=")}")
match .cursor.take()
    string value
        println("taken={value}")
    none
        println("missing")
println("position={cursor.offset()}")
match text.lex.tokenize("x ~ y")
    string[] unexpected
        println("unexpected")
    error problem
        println("lex-error")

bool is_sign(string token)
    return token == "+" or token == "-"

text.lex.Cursor combinator := text.lex.Cursor(["+", "-", "name", "="])
println("sequence-rejected={.combinator.accept_sequence(["+", "="])}")
println("sequence-offset={combinator.offset()}")
string[] signs := .combinator.take_while(is_sign)
println("repeated={signs.join("|")}")
println("choice={.combinator.accept_any(["name", "other"])}")
println("sequence-accepted={.combinator.accept_sequence(["="])}")
println("combinator-done={combinator.done()}")

int number := 255
println("radix-bin={text.base_string(number, base = 2)}")
println("radix-oct={number.base_string(base = 8)}")
println("radix-hex={text.base_string(number, base = 16, uppercase = true)}")
println("radix-negative={text.base_string(-255, base = 16, uppercase = true)}")
match text.base_string(number, base = 1)
    string unexpected
        println("unexpected")
    error problem
        println("base-error")

text.Cursor input := text.Cursor("12W0猫")
nat repeat_count := .input.take_nat()
string character := .input.take_char()
println("prefix={repeat_count}:{character}:{input.offset()}")
repeat_count = .input.take_nat()
character = .input.take_char()
println("unicode={repeat_count}:{character}:{input.offset()}")
match .input.take_char()
    string unexpected
        println("unexpected={unexpected}")
    error failure
        println("cursor-end={failure.code}")
text.Cursor invalid_prefix := text.Cursor("W")
match .invalid_prefix.take_nat()
    nat unexpected
        println("unexpected={unexpected}")
    error failure
        println("cursor-invalid={failure.code}:{invalid_prefix.offset()}")
string[] characters := text.characters("a猫")
println("characters={characters.join("|")}:{len(text.characters(""))}")
