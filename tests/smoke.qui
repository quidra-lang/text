import text

println(text.lower_ascii("HELLO, World!"))
println(text.upper_ascii("hello, World!"))
match "name=value=more".split_once("=")
    (string key, string value)
        println("{key}:{value}")
    none
        println("missing")
match "no delimiter".split_once("=")
    (string key, string value)
        println("unexpected")
    none
        println("no-match")

string[] words := text.ascii_words("Apple, banana APPLE!", ignore_case = true)
println("{words.join("|")}")

string csv_input := "name,note{NL}Aki,{DQ}a,b{DQ}{NL}"
rows := text.csv.parse(csv_input)
println("{rows[1][0]}:{rows[1][1]}")

parameters := text.url.query.parse("tag=C%2B%2B&tag=AI+ML&empty=&flag")
match parameters.get("tag")
    string[] tags
        println("{tags.join("|")}")
    none
        println("missing")
match parameters.get("empty")
    string[] values
        println("empty={values[0].len()}")
    none
        println("missing")
match text.csv.parse(DQ + "broken")
    string[][] unexpected
        println("unexpected")
    error problem
        println("csv-error")
match text.url.query.parse("a=%ZZ")
    map<string, string[]> unexpected
        println("unexpected")
    error problem
        println("url-error")

extras := text.url.query.parse("?a=1&&a=2&")
match extras.get("a")
    string[] values
        println(extras.keys() == ["a"] and values == ["1", "2"])
    none
        println(false)
