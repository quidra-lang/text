string[] | error tokenize(string source)
    string digits := "0123456789"
    string letters := "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
    string punctuation := "+-*/%=!<>&|()[]{{}};:,.?"
    string[] result := []
    nat i := 0
    while i < len(source)
        string ch := source[i]
        if ch == " " or ch == HT or ch == NL or ch == CR
            i += 1
            continue
        nat start := i
        if letters.contains(ch)
            i += 1
            while i < len(source) and (letters.contains(source[i]) or digits.contains(source[i]))
                i += 1
        elif digits.contains(ch)
            i += 1
            while i < len(source) and digits.contains(source[i])
                i += 1
        elif ch == DQ
            i += 1
            while i < len(source) and source[i] != DQ
                i += 1
            if i >= len(source)
                return error("unterminated quoted token", code = "TEXT_LEX")
            i += 1
        elif punctuation.contains(ch)
            i += 1
            if i < len(source)
                string pair := ch + source[i]
                if pair == "==" or pair == "!=" or pair == "<=" or pair == ">=" or pair == "&&" or pair == "||"
                    i += 1
        else
            return error("unexpected character in token stream", code = "TEXT_LEX")
        result = result.append(source[start:<i])
    return result

class Cursor(const string[] tokens)
    private nat position := 0

    bool done()
        return position == len(tokens)

    nat offset()
        return position

    string | none peek()
        if position >= len(tokens)
            return none
        return tokens[position]

    string | none .take()
        if position >= len(tokens)
            return none
        string current := tokens[position]
        position += 1
        return current

    bool .accept(string token)
        if position < len(tokens) and tokens[position] == token
            position += 1
            return true
        return false

    bool .accept_any(string[] options)
        if position >= len(tokens)
            return false
        for string option := options[]
            if tokens[position] == option
                position += 1
                return true
        return false

    bool .accept_sequence(string[] sequence)
        if position + len(sequence) > len(tokens)
            return false
        for nat i < len(sequence)
            if tokens[position + i] != sequence[i]
                return false
        position += len(sequence)
        return true

    string[] .take_while(func<bool>(string) predicate)
        string[] values := []
        while position < len(tokens) and predicate(tokens[position])
            values = values.append(tokens[position])
            position += 1
        return values

    void | error .expect(string token)
        if not .accept(token)
            return error("unexpected token", code = "TEXT_PARSE")
        return void

