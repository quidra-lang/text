string[] | error words(string source)
    upper := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    lower := "abcdefghijklmnopqrstuvwxyz"
    digits := "0123456789"
    string[] result := []
    current := ""
    for: nat i < source.len()
        character := source[i]
        if character == "_" or character == "-"
            if current != ""
                result = result.append(current)
                current = ""
            continue
        uppercase := upper.contains(character)
        if not uppercase and not lower.contains(character) and not digits.contains(character)
            return error("identifier contains a non-ASCII identifier character", code = "TEXT_IDENTIFIER")
        if uppercase and current != ""
            previous := source[i - 1]
            boundary := lower.contains(previous) or digits.contains(previous)
            if not boundary and i + 1 < source.len()
                boundary = upper.contains(previous) and lower.contains(source[i + 1])
            if boundary
                result = result.append(current)
                current = ""
        current += character.lower_ascii()
    if current != ""
        result = result.append(current)
    return result

string | error snake(string source)
    parts := try words(source)
    return parts.join("_")

string | error kebab(string source)
    parts := try words(source)
    return parts.join("-")

string | error pascal(string source)
    parts := try words(source)
    result := ""
    for part := parts[]
        result += part[0].upper_ascii() + part[1:]
    return result

string | error camel(string source)
    parts := try words(source)
    if parts.len() == 0
        return ""
    result := parts[0]
    for: 1 <= nat i < parts.len()
        result += parts[i][0].upper_ascii() + parts[i][1:]
    return result
