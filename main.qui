public import csv = "./csv.qui"
public import url = "./url.qui"
public import identifier = "./identifier.qui"
public import calendar = "./calendar.qui"
public import layout = "./layout.qui"
public import lex = "./lex.qui"

string lower_ascii(string source)
    return source.lower_ascii()

string upper_ascii(string source)
    return source.upper_ascii()

string join<T>(T[] values, string separator)
    result := ""
    for nat i < len(values)
        if i > 0
            result += separator
        result += "{values[i]}"
    return result

private string | error padding(string source, nat width, string fill)
    if len(fill) != 1
        return error("padding fill must contain exactly one Unicode code point", code = "TEXT_PADDING")
    source_width := len(source)
    count := if width > source_width then width - source_width else 0
    return string.repeat(fill, count)

string | error pad_start(extend string source, nat width, fill := " ")
    return (try padding(source, width, fill)) + source

string | error pad_end(extend string source, nat width, fill := " ")
    return source + (try padding(source, width, fill))

string | error translate(extend string source, string original, string replacement)
    if len(original) != len(replacement)
        return error("translation alphabets must have equal Unicode code-point lengths", code = "TEXT_TRANSLATE")
    map<string, string> mapping
    for nat i < len(original)
        .mapping.set(original[i], replacement[i])
    result := ""
    for nat i < len(source)
        character := source[i]
        match mapping.get(character)
            string mapped
                result += mapped
            none
                result += character
    return result

(string, string) | none split_once(extend string source, string separator)
    if separator == ""
        error("split_once separator cannot be empty", code = "TEXT_SPLIT")
    match source.find(separator)
        nat position
            return (source[:<position], source[(position + len(separator)):])
        none
            return none

string[] ascii_words(string source, ignore_case := false)
    string[] words := []
    current := ""
    uppercase := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    lowercase := "abcdefghijklmnopqrstuvwxyz"
    for nat index < len(source)
        character := source[index]
        upper := uppercase.contains(character)
        if upper and ignore_case
            character = character.lower_ascii()
        if upper or lowercase.contains(character)
            current += character
        elif current != ""
            words = words.append(current)
            current = ""
    if current != ""
        words = words.append(current)
    return words

(string, nat)[] runs(string source)
    (string, nat)[] result := []
    if len(source) == 0
        return result
    current := source[0]
    nat count := 1
    for 1 <= nat i < len(source)
        if source[i] == current
            count += 1
        else
            result = result.append((current, count))
            current = source[i]
            count = 1
    return result.append((current, count))


string | error base_string(extend int value, base := 10, uppercase := false)
    if base < 2 or base > 36
        return error("base must be between 2 and 36", code = "TEXT_BASE")
    if value == 0
        return "0"
    negative := value < 0
    remaining := if negative then -value else value
    alphabet := if uppercase then "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ" else "0123456789abcdefghijklmnopqrstuvwxyz"
    result := ""
    while remaining > 0
        digit := remaining % base
        result = alphabet[digit] + result
        remaining /= base
    if negative
        return "-" + result
    return result

class Cursor(const string source)
    private nat position := 0

    nat offset()
        return position

    bool done()
        return position == len(source)

    string | error .take_char()
        if done()
            return error("expected a character at the end of input", code = "TEXT_CURSOR")
        value := source[position]
        position += 1
        return value

    nat | error .take_nat()
        end := position
        while end < len(source) and "0123456789".contains(source[end])
            end += 1
        if end == position
            return error("expected an ASCII digit", code = "TEXT_CURSOR")
        match nat.parse(source[position:<end])
            nat value
                position = end
                return value
            error failure
                return failure

string[] characters(extend string source)
    string[] result := []
    for nat i < len(source)
        result = result.append(source[i])
    return result
